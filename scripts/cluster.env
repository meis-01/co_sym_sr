# Copy to scripts/cluster.env and edit for your site. Bash syntax is intentional.
CLUSTER_EXECUTION_MODE=micromamba       # modules | micromamba | apptainer
CLUSTER_PYTHON=python3              # Python 3.12 compatible with the loaded CFD modules
CLUSTER_MODULES=()                  # e.g. (GCC/13.2.0 OpenMPI/4.1.6 Python/3.12.3 FEniCS/2019.2)

# Set these to persistent project and scratch locations on the cluster.
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CLUSTER_PROJECT_PARENT="${CLUSTER_PROJECT_PARENT:-$(cd "$PROJECT_ROOT/.." && pwd)}"
if [[ "$CLUSTER_EXECUTION_MODE" == micromamba ]]; then
  RUN_ROOT="${RUN_ROOT:-$CLUSTER_PROJECT_PARENT/cluster-runs}"
  LOG_ROOT="${LOG_ROOT:-$CLUSTER_PROJECT_PARENT/cluster-logs}"
else
  RUN_ROOT="${RUN_ROOT:-${SCRATCH:-$PROJECT_ROOT}/cardiac-flow-runs}"
  LOG_ROOT="${LOG_ROOT:-${SCRATCH:-$PROJECT_ROOT}/cardiac-flow-logs}"
fi
MANIFEST_ROOT="${MANIFEST_ROOT:-$RUN_ROOT/manifests}"

# SLURM resources. The current solver is serial: keep this at 1 unless a
# separately tested implementation actually uses more CPUs. Values above 8
# are rejected before submission.
SLURM_CPUS="${SLURM_CPUS:-1}"
SLURM_MEMORY="${SLURM_MEMORY:-8G}"
SLURM_TIME="${SLURM_TIME:-12:00:00}"
SLURM_PARTITION="${SLURM_PARTITION:-}" # empty means site's default
SLURM_ACCOUNT="${SLURM_ACCOUNT:-}"     # empty means site's default
SLURM_ARRAY_CONCURRENCY="${SLURM_ARRAY_CONCURRENCY:-4}"
# Complete 32+36 SR campaign (new dedicated root; no persistent SSH needed):
# bash scripts/slurm/submit-sr.sh submit /scratch/USER/sr-campaign --dry-run
# bash scripts/slurm/submit-sr.sh submit /scratch/USER/sr-production
# bash scripts/slurm/submit-sr.sh status /scratch/USER/sr-production
# See docs/sr_workflow.md; calibrate memory/time within your partition limits.
SR_QUALIFICATION="${SR_QUALIFICATION:-}" # passed scripts/sr.py assess report for sr_sweep

# Required only when CLUSTER_EXECUTION_MODE=micromamba. These defaults match
# <project-parent>/.tools/micromamba, .micromamba, and .cfd-env. The prefix is
# pre-provisioned and is read-only from this workflow.
MICROMAMBA_EXE="${MICROMAMBA_EXE:-$CLUSTER_PROJECT_PARENT/.tools/micromamba}"
MICROMAMBA_ROOT_PREFIX="${MICROMAMBA_ROOT_PREFIX:-$CLUSTER_PROJECT_PARENT/.micromamba}"
MICROMAMBA_ENV_PREFIX="${MICROMAMBA_ENV_PREFIX:-$CLUSTER_PROJECT_PARENT/.cfd-env}"
MICROMAMBA_PYTHON="${MICROMAMBA_PYTHON:-python}"

# Required only when CLUSTER_EXECUTION_MODE=apptainer.
APPTAINER_IMAGE=""
APPTAINER_PYTHON=/opt/venv/bin/python

